{
  "name": "pi-charter",
  "version": "0.0.0",
  "description": "Pi extension for durable objectives, evolving phases, visual evidence reports, and bounded autonomous continuation.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "charter",
    "agent-contract",
    "goal-tracking"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "ci": "bun run check-types && bun test"
  },
  "dependencies": {
    "pi-extension-utils": "^0.7.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.0.0"
  }
}
